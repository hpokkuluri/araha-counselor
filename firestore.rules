rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isApprovedParent(uid) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(uid))
        && request.auth.uid in get(/databases/$(database)/documents/users/$(uid)).data.approvedParents;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isApprovedParent(uid);
      allow create, update, delete: if isOwner(uid);

      match /attempts/{id} {
        allow read: if isOwner(uid) || isApprovedParent(uid);
        allow write: if isOwner(uid);
      }
    }

    match /linkCodes/{code} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.studentUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.studentUid == request.auth.uid;
    }

    match /linkRequests/{studentUid}/from/{parentUid} {
      allow read: if isOwner(studentUid) || (signedIn() && request.auth.uid == parentUid);
      allow create: if signedIn()
        && request.auth.uid == parentUid
        && request.resource.data.parentUid == parentUid
        && request.resource.data.status == "pending";
      allow update: if isOwner(studentUid);
      allow delete: if isOwner(studentUid) || (signedIn() && request.auth.uid == parentUid);
    }
  }
}
